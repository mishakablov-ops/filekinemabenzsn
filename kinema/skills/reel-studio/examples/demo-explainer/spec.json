{
 "id": "demo-explainer",
 "mode": "explainer",
 "style": "dusk",
 "fps": 60,
 "voice": {
  "src": "projects/demo-explainer/voice.wav",
  "words": "projects/demo-explainer/words.json"
 },
 "music": {
  "src": "music/pulse-tech.m4a",
  "volume": 0.13,
  "duck": 0.5
 },
