diff --git a/pixcine/engine/src/Film.tsx b/pixcine/engine/src/Film.tsx
index ce9a50c..22bbefc 100644
--- a/pixcine/engine/src/Film.tsx
+++ b/pixcine/engine/src/Film.tsx
@@ -415,6 +415,54 @@ const OVERLAYS: Record<string, OV> = {
       </AbsoluteFill>
     );
   },
+  /** «every N seconds» HUD (testosteron short, 09.11.2026): running timer + segmented level bar + multiplier.
+   *  c.levels = [{t, n, mult}] (n = filled segments of c.max), c.start = the timer's zero */
+  meter: ({ c, t, w, h }) => {
+    const k = w / 1080, a = life(c, t, 0.25, 0.3);
+    const lv = (c.levels as any[]).filter((l) => t >= l.t);
+    const cur = lv.length ? lv[lv.length - 1] : { n: 0, mult: "×1", t: -9 };
+    const prev = lv.length > 1 ? lv[lv.length - 2].n : 0;
+    const up = clamp((t - cur.t) / 0.35);
+    const fill = lerp(prev, cur.n, ease.out(up));
+    const pop = t - cur.t < 0.6 ? lerp(1.45, 1, ease.out(clamp((t - cur.t) / 0.4))) : 1;
+    const max = c.max ?? 9;
+    // clockKeys [[t, seconds], …]: the shown clock is interpolated between keys (lets a tightened voice still read 0:10, 0:20 …
+    // on every level-up, and lets the clock spin back on a rewind); after the last key it runs in real time
+    const ck = c.clockKeys as [number, number][] | undefined;
+    let sf = t - (c.start ?? 0);
