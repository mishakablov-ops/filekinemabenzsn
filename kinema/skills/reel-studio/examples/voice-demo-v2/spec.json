{
 "id": "voice-demo-v2",
 "mode": "explainer",
 "style": "dusk",
 "fps": 60,
 "voice": {
  "src": "projects/voice-demo-v2/voice.wav",
  "words": "projects/voice-demo-v2/words.json"
 },
 "music": {
  "src": "music/drive-promo.m4a",
  "volume": 0.12,
  "duck": 0.45
 },
 "tail": 1.4,
 "captions": {
  "mode": "editorial",
  "pos": "top",
  "uppercase": true
 },
 "sfx": [
  {
   "at": "@хуже",
   "id": "pk-notify-system-alert-sfx",
   "volume": 0.9
  },
  {
   "at": "@по косточкам",
   "id": "pk-click-ui-button",
   "volume": 0.9,
   "alignPeak": false
  },
  {
   "at": "@по косточкам+0.4",
   "id": "pk-digital-data-load-sfx-1",
   "volume": 1.0,
   "alignPeak": false
  },
  {
   "at": "@экраны",
   "id": "pk-digital-digitasl-burst-sfx",
   "volume": 0.7
  },
  {
   "at": "@тексты",
   "id": "pk-shimmer-ui-dissolvre-sfx",
   "volume": 0.9
  },
  {
   "at": "@отзывы+0.9",
   "id": "pk-result-failure",
   "volume": 0.55
  },
  {
   "at": "@план",
   "id": "pk-click-ui-button",
   "volume": 0.5,
   "alignPeak": false
  },
  {
   "at": "@сделать",
   "id": "pk-click-ui-button",
   "volume": 0.5,
   "alignPeak": false
  },
  {
   "at": "@лучше",
   "id": "pk-click-ui-button",
   "volume": 0.5,
   "alignPeak": false
  },
  {
   "at": "@Нисколько",
   "id": "pk-digital-digitasl-burst-sfx",
   "volume": 1.0
  },
  {
   "at": "@профиля",
   "id": "pk-notify-notification-sfx-1",
   "volume": 0.85
  }
 ],
 "scenes": [
  {
   "id": "hook-office",
   "at": 0,
   "bg": {
    "block": "Room3D",
    "props": {
     "preset": "office",
     "lights": "evening",
     "cam": "pushIn",
     "screen": {
      "block": "NotificationStack",
      "props": {
       "items": [
        {
         "app": "App Store · новый отзыв",
         "text": "Неудобно. Ушла к конкурентам",
         "stars": 1,
         "at": "@боитесь"
        },
        {
         "app": "App Store · новый отзыв",
         "text": "Опять вылетает при записи",
         "stars": 2,
         "at": "@хуже"
        }
       ]
      }
     }
    }
   },
   "camera": "still"
  },
  {
   "id": "agent-macbook",
   "at": "@Этот",
   "transition": "zoom",
   "bg": {
    "block": "MacBook",
    "props": {
     "cam": "toScreen",
     "enter": "rise",
     "screen": {
      "block": "Terminal",
      "props": {
       "w": 1280,
       "h": 840,
       "size": 36,
       "title": "replica — claude",
       "lines": [
        {
         "kind": "prompt",
         "text": "разбери приложение конкурента по косточкам",
         "at": "@Этот+0.1",
         "cps": 30
        },
        {
         "kind": "tool",
         "name": "Read",
         "arg": "screens/*",
         "sub": [
          "18 экранов · 42 состояния"
         ],
         "at": "@по косточкам",
         "state": "ok"
        },
        {
         "kind": "tool",
         "name": "Fetch",
         "arg": "app-store/reviews",
         "sub": [
          "1 340 отзывов · 6 жалоб"
         ],
         "at": "@по косточкам+0.45",
         "state": "ok"
        },
        {
         "kind": "text",
         "text": "Тексты, экраны, отзывы — собраны.",
         "at": "@по косточкам+0.9",
         "color": "#E08A55"
        }
       ]
      }
     }
    }
   },
   "camera": "still"
  },
  {
   "id": "exploded-app",
   "at": "@экраны",
   "transition": "glitch",
   "camera": "still",
   "layers": [
    {
     "block": "Cards3D",
     "pos": {
      "preset": "stage"
     },
     "props": {
      "cam": {
       "from": [
        0,
        0,
        -520
       ],
       "to": [
        0,
        0,
        -100
       ],
       "rx": [
        10,
        4
       ],
       "ry": [
        -10,
        9
       ]
      },
      "items": [
       {
        "block": "AppScreen",
        "w": 330,
        "h": 715,
        "x": -250,
        "z": -420,
        "ry": 16,
        "at": 0,
        "props": {
         "sections": [
          {
           "type": "header",
           "app": "Окно",
           "title": "Запись"
          },
          {
           "type": "slots",
           "label": "Свободное время",
           "slots": [
            "10:00",
            "11:30",
            "13:00",
            "14:30"
           ],
           "selected": 1
          },
          {
           "type": "button",
           "label": "Записаться"
          }
         ]
        }
       },
       {
        "block": "AppScreen",
        "w": 330,
        "h": 715,
        "x": 250,
        "z": -420,
        "ry": -16,
        "at": 0.12,
        "props": {
         "sections": [
          {
           "type": "header",
           "app": "Окно",
           "title": "Оплата"
          },
          {
           "type": "card",
           "name": "Стрижка",
           "sub": "60 мин",
           "value": "1 500 ₽"
          },
          {
           "type": "button",
           "label": "Оплатить"
          }
         ]
        }
       },
       {
        "block": "AppScreen",
        "w": 330,
        "h": 715,
        "x": 0,
        "z": -760,
        "at": 0.24,
        "props": {
         "sections": [
          {
           "type": "header",
           "app": "Окно",
           "title": "Профиль"
          },
          {
           "type": "rows",
           "rows": [
            {
             "label": "Напоминания",
             "value": "нет",
             "status": "bad"
            },
            {
             "label": "Бонусы",
             "value": "есть",
             "status": "good"
            }
           ]
          }
         ]
        }
       },
       {
        "block": "Quote",
        "w": 620,
        "h": 250,
        "x": 0,
        "y": 330,
        "z": 140,
        "at": "@тексты",
        "props": {
         "text": "Запись за 30 секунд — без звонков",
         "size": 44
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "reviews-street",
   "at": "@отзывы",
   "transition": "whip",
   "bg": {
    "block": "Street3D",
    "props": {
     "time": "evening",
     "cam": "eye",
     "people": 12
    }
   },
   "camera": "still",
   "layers": [
    {
     "block": "ReviewFeed",
     "props": {
      "items": [
       {
        "source": "App Store",
        "stars": 5,
        "text": "Удобно, записалась за минуту"
       },
       {
        "source": "App Store",
        "stars": 2,
        "text": "Нет напоминаний — пропустила визит"
       },
       {
        "source": "Google Play",
        "stars": 1,
        "text": "После обновления вылетает"
       }
      ],
      "focus": {
       "at": 0.9,
       "keep": [
        1,
        2
       ]
      }
     }
    }
   ]
  },
  {
   "id": "plan-studio",
   "at": "@И за",
   "transition": "push",
   "bg": {
    "block": "Room3D",
    "props": {
     "preset": "studio",
     "lights": "evening",
     "cam": "front"
    }
   },
   "camera": "still",
   "layers": [
    {
     "block": "StatSlam",
     "props": {
      "value": "20",
      "unit": "мин",
      "label": "на весь разбор"
     },
     "until": "@собирает-0.1",
     "exit": "blur"
    },
    {
     "block": "Checklist",
     "props": {
      "title": "План: как сделать лучше",
      "items": [
       "Напоминания по SMS",
       "Онлайн-оплата",
       "Тексты без канцелярита",
       "Исправить вылеты"
      ],
      "checkAt": [
       "@план",
       "@как",
       "@сделать",
       "@лучше"
      ]
     },
     "at": "@собирает"
    }
   ]
  },
  {
   "id": "price-city",
   "at": "@Сколько",
   "transition": "blur",
   "bg": {
    "block": "City3D",
    "props": {
     "look": "dusk",
     "cam": "dive"
    }
   },
   "camera": "still",
   "layers": [
    {
     "block": "PricingCards",
     "props": {
      "tiers": [
       {
        "name": "Студия",
        "price": "500 000 ₽"
       },
       {
        "name": "Фрилансер",
        "price": "150 000 ₽"
       },
       {
        "name": "Скилл",
        "price": "? ₽",
        "hot": true
       }
      ]
     }
    },
    {
     "block": "Cursor",
     "props": {
      "points": [
       {
        "x": 560,
        "y": 1640,
        "at": 0.2
       },
       {
        "x": 190,
        "y": 1120,
        "at": 0.9
       },
       {
        "x": 540,
        "y": 1120,
        "at": 1.5
       },
       {
        "x": 900,
        "y": 1120,
        "at": 2.2,
        "click": true
       }
      ]
     },
     "overlap": true
    }
   ]
  },
  {
   "id": "free-tunnel",
   "at": "@Нисколько",
   "style": "blaze",
   "transition": "slam",
   "camera": "punch",
   "bg": {
    "block": "Tunnel3D",
    "props": {
     "shape": "hex"
    }
   },
   "layers": [
    {
     "block": "Marquee",
     "props": {
      "text": "без подписки",
      "cross": true,
      "size": 96
     },
     "pos": {
      "x": 0,
      "y": 1260,
      "w": 1080,
      "h": 300
     },
     "overlap": true
    }
   ]
  },
  {
   "id": "cta-iphone",
   "at": "@Ссылка",
   "transition": "blur",
   "bg": {
    "block": "IPhone17",
    "props": {
     "enter": "rise",
     "screen": {
      "block": "SocialProfile",
      "props": {
       "handle": "reel.studio",
       "name": "Ролики, которые собирает агент",
       "bio": [
        "Разбор приложений",
        "Объяснялки с голосом",
        "Reels · Shorts · TikTok"
       ],
       "link": "t.me/reel_studio",
       "pressAt": "@профиля",
       "tiles": [
        {
         "title": "Экраны",
         "sub": "18 шт"
        },
        {
         "title": "Отзывы",
         "sub": "фильтр"
        },
        {
         "title": "План",
         "sub": "20 мин"
        }
       ]
      }
     }
    }
   },
   "camera": "still"
  }
 ]
}