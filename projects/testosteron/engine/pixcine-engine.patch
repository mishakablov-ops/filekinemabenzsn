diff --git a/pixcine/engine/src/Film.tsx b/pixcine/engine/src/Film.tsx
index ce9a50c..28c447a 100644
--- a/pixcine/engine/src/Film.tsx
+++ b/pixcine/engine/src/Film.tsx
@@ -415,6 +415,46 @@ const OVERLAYS: Record<string, OV> = {
       </AbsoluteFill>
     );
   },
+  /** «every N seconds» HUD (testosteron short, 09.11.2026): running timer + segmented level bar + multiplier.
+   *  c.levels = [{t, n, mult}] (n = filled segments of c.max), c.start = the timer's zero */
+  meter: ({ c, t, w, h }) => {
+    const k = w / 1080, a = life(c, t, 0.25, 0.3);
+    const lv = (c.levels as any[]).filter((l) => t >= l.t);
+    const cur = lv.length ? lv[lv.length - 1] : { n: 0, mult: "×1", t: -9 };
+    const prev = lv.length > 1 ? lv[lv.length - 2].n : 0;
+    const up = clamp((t - cur.t) / 0.35);
+    const fill = lerp(prev, cur.n, ease.out(up));
+    const pop = t - cur.t < 0.6 ? lerp(1.45, 1, ease.out(clamp((t - cur.t) / 0.4))) : 1;
+    const max = c.max ?? 9;
+    const secs = Math.max(0, Math.floor(t - (c.start ?? 0)));
+    const clock = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, "0")}`;
+    const segCol = (i: number) => (i < 3 ? "#5ad05a" : i < 6 ? "#ffd23a" : "#ff4a2a");
+    const flash = t - cur.t < 0.25 && cur.t > 0;
+    return (
+      <div style={{ position: "absolute", left: 40 * k, right: 40 * k, top: (c.y ?? 0.03) * h, display: "flex", gap: 22 * k, alignItems: "stretch", fontFamily: FONT, opacity: a }}>
+        <div style={{ ...pbox(k, "#0d0c10", "#f2efe6"), padding: `${10 * k}px ${18 * k}px`, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", minWidth: 190 * k }}>
+          <div style={{ fontSize: 26 * k, color: "#b8b2a4" }}>ВРЕМЯ</div>
+          <div style={{ fontSize: 66 * k, lineHeight: 1, color: "#f2efe6" }}>{clock}</div>
+        </div>
+        <div style={{ flex: 1, ...pbox(k, flash ? "#3a2a0a" : "#0d0c10", flash ? "#ffd23a" : "#f2efe6"), padding: `${10 * k}px ${18 * k}px` }}>
+          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "baseline" }}>
+            <div style={{ fontSize: 30 * k, color: "#f2efe6" }}>{c.title ?? "ТЕСТОСТЕРОН"}</div>
+            <div style={{ fontSize: 54 * k, lineHeight: 1, color: "#ffd23a", textShadow: outline(Math.round(4 * k)), transform: `scale(${pop})`, transformOrigin: "100% 60%" }}>{cur.mult}</div>
+          </div>
+          <div style={{ display: "flex", gap: 6 * k, marginTop: 10 * k }}>
+            {Array.from({ length: max }, (_, i) => {
+              const f = clamp(fill - i);
+              return (
+                <div key={i} style={{ flex: 1, height: 34 * k, background: "#24222a", boxShadow: `inset 0 0 0 ${3 * k}px #000`, position: "relative" }}>
+                  <div style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: `${f * 100}%`, background: segCol(i), boxShadow: `inset 0 ${-6 * k}px 0 rgba(0,0,0,0.25)` }} />
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      </div>
+    );
+  },
   /** full-frame flat colour (black / white flash) */
   black: ({ c, t }) => <AbsoluteFill style={{ background: c.color ?? "#000", opacity: life(c, t, c.fi ?? 0.2, c.fo ?? 0.2) }} />,
   /** pixel phone with app header and chat/notification messages */
