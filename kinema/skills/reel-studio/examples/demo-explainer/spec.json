 "scenes": [
  {
   "id": "hook-office",
   "at": 0,
   "bg": {
    "block": "Room3D",
    "props": {
     "preset": "office",
     "lights": "evening",
     "cam": "pushIn",
     "screen": {
      "block": "Progress",
      "props": {
       "label": "Монтаж…",
       "dur": 9,
       "to": 37
      }
     }
    }
   },
   "camera": "still"
  },
  {
   "id": "agent-laptop",
   "at": "@Теперь",
   "transition": "zoom",
   "bg": {
    "block": "MacBook",
    "props": {
     "cam": "toScreen",
     "enter": "rise",
     "screen": {
      "block": "Terminal",
      "props": {
       "w": 1280,
       "h": 840,
       "size": 36,
       "title": "reel — claude",
       "lines": [
        {
         "kind": "prompt",
         "text": "сделай ролик: как ИИ монтирует видео",
         "at": "@Вы",
         "cps": 22
        },
        {
         "kind": "tool",
         "name": "Write",
         "arg": "script.md",
         "sub": [
          "20 карточек · 95 слов"
         ],
         "at": "@сценарий",
         "state": "ok"
        }
       ]
      }
     }
    }
   },
   "camera": "still"
  },
  {
   "id": "cliches",
   "at": "@без",
   "transition": "blur",
