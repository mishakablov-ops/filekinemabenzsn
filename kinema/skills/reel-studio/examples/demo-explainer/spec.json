    {
     "block": "StrikeList",
     "props": {
      "items": [
       "Давайте разберёмся",
       "В современном мире",
       "Революционный"
      ],
      "strikeAt": [
       "@давайте",
       "@прочих",
       "@штампов"
      ],
      "size": 76
     }
    }
   ]
  },
  {
   "id": "voice",
   "at": "@Озвучивает",
