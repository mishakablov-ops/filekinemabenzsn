index 22bbefc..f441252 100644
--- a/pixcine/engine/src/Film.tsx
+++ b/pixcine/engine/src/Film.tsx
@@ -467,4 +467,38 @@ const OVERLAYS: Record<string, OV> = {
   black: ({ c, t }) => <AbsoluteFill style={{ background: c.color ?? "#000", opacity: life(c, t, c.fi ?? 0.2, c.fo ?? 0.2) }} />,
   /** pixel phone with app header and chat/notification messages */
   phone: ({ c, t, w, h }) => <PhoneUI c={{ ...c, center: true }} t={t} h={Math.min(h, w * 1.2)} a={1} />,
+  /** short-video feed on a pixel phone: full-screen clips swipe up at c.swipes (seconds from t0); clip = {title, color, sub?, likes?} */
+  feed: ({ c, t, w, h }) => {
+    const k = Math.min(h, w * 1.2) / 1440;
+    const lt = t - c.t0;
+    const rise = ease.out(clamp(lt / 0.35)) * (1 - ease.in(clamp((t - (c.t1 - 0.3)) / 0.3)));
+    const W = 560 * k, H = 1040 * k;
+    const clips: any[] = c.clips ?? [];
+    let pos = 0;
+    for (const s of (c.swipes ?? []) as number[]) pos += ease.inOut(clamp((lt - s) / 0.22));
+    const y0 = c.y ?? 0.42;
+    return (
+      <AbsoluteFill style={{ fontFamily: FONT }}>
+        <div style={{ position: "absolute", left: w / 2 - W / 2, top: h * y0 - H / 2 + (1 - rise) * h, width: W, height: H, background: "#121318",
+          borderRadius: 46 * k, padding: 18 * k, boxShadow: `0 0 ${120 * k}px rgba(255,60,120,0.35), inset 0 0 0 ${6 * k}px #2a2c34`,
+          transform: `rotate(${noise1(t * 0.5, 9) * 1.5}deg)` }}>
+          <div style={{ width: "100%", height: "100%", borderRadius: 28 * k, overflow: "hidden", position: "relative", background: "#000" }}>
+            {clips.map((cl, i) => {
+              const top = (i - pos) * (H - 36 * k);
+              if (top > H || top < -H) return null;
+              return (
+                <div key={i} style={{ position: "absolute", left: 0, right: 0, top, height: H - 36 * k, background: cl.color ?? "#2a2a3a",
+                  display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", color: "#fff", textAlign: "center" }}>
+                  <div style={{ fontSize: (cl.size ?? 64) * k, lineHeight: 1.1, padding: `0 ${24 * k}px`, textShadow: `${4 * k}px ${4 * k}px 0 #000` }}>{cl.title}</div>
+                  {cl.sub ? <div style={{ fontSize: 30 * k, marginTop: 18 * k, color: "#ffe86a", textShadow: `${3 * k}px ${3 * k}px 0 #000` }}>{cl.sub}</div> : null}
+                  <div style={{ position: "absolute", right: 18 * k, bottom: 120 * k, fontSize: 26 * k, textAlign: "center", lineHeight: 1.3 }}>❤<br />{cl.likes ?? "1.2M"}</div>
+                  <div style={{ position: "absolute", left: 22 * k, bottom: 40 * k, fontSize: 24 * k, opacity: 0.9 }}>@{cl.author ?? "user"}</div>
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      </AbsoluteFill>
+    );
+  },
 };
